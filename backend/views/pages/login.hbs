<section id="login-page">
    <form id="form_login" >
        <div id="div_alert"></div>
       <div id="background-login">
        <h1>Bem vindo de volta!</h1>
        <h2>Estamos felizes em tê-lo conosco </h2>
        <div class="div_msg"></div>
        <div id="cadastro-login">
            <p>Email</p>
            <input type="email" class="input-login" name="email" required>
            <p>Senha</p>
            <input type="password" class="input-login" name="senha" required>
        </div>
        <button type="submit" id="btn-login">Enviar</button>
        <h3 id="btn_login_sigin" >Ainda não tem uma conta?</h3>
       </div>
    </form>
</section>

 <script src="/Scripts/login.js"></script>